#!/usr/bin/env python3
"""zaddrcheck <address> -> one JSON record."""
import json
import sys
from zaddrcheck_core import classify


def main() -> int:
    address = sys.argv[1] if len(sys.argv) == 2 else ""
    print(json.dumps(classify(address), separators=(",", ":"), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
